{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-refresh",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/living-intelligence-refresh",
      "schedule": "0 12 * * *"
    }
  ]
}
